<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Title>Lepton Launcher - Minecraft Launcher for Java and Bedrock</Title>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="../../../assets/icon.ico" Link="icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lepton\Lepton.csproj"/>
    </ItemGroup>
</Project>
